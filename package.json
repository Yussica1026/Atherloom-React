{
  "name": "atherloom-react",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "android:prepare": "npm run build",
    "typecheck": "tsc -b --pretty false",
    "test:books": "esbuild ./src/features/books/analysis.test.ts ./src/features/books/ingest.test.ts ./src/features/books/output.test.ts --bundle --platform=node --format=cjs --out-extension:.js=.cjs --outdir=artifacts/book-tests && node --test artifacts/book-tests/analysis.test.cjs artifacts/book-tests/ingest.test.cjs artifacts/book-tests/output.test.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
